<%@ page errorPage="loiDatabase.jsp" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="WEB-INF/jspf/common.jspf" %>
<%Monan mon=new MonanDAO().timTheoId(parseId(request.getParameter("id")));String tuKhoa=request.getParameter("tuKhoa");if(tuKhoa==null)tuKhoa="";%>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Chi tiết món ăn · RestMan</title><link rel="stylesheet" href="<%=request.getContextPath()%>/style.css"></head><body><%@ include file="WEB-INF/jspf/header.jspf" %><main class="container"><a class="back" href="gdThongTinMonAn.jsp<%=tuKhoa.isEmpty()?"":"?tuKhoa="+java.net.URLEncoder.encode(tuKhoa,"UTF-8")%>">← Quay lại danh sách</a><section class="panel"><h2>Thông tin chi tiết món ăn</h2><%if(mon==null){%><div class="notice">Không tìm thấy món ăn tương ứng.</div><%}else{%><dl class="details"><dt>Mã món ăn</dt><dd>MA<%=mon.getId()%></dd><dt>Tên món ăn</dt><dd><%=esc(mon.getTen())%></dd><dt>Loại món</dt><dd><%=esc(mon.getLoai())%></dd><dt>Giá</dt><dd><%=money(mon.getGia())%> VNĐ</dd><dt>Khẩu phần</dt><dd><%=esc(mon.getKhauphan())%></dd><dt>Mô tả</dt><dd><%=esc(mon.getMota())%></dd></dl><%}%></section></main></body></html>
