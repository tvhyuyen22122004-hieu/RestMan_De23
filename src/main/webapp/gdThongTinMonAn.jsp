<%@ page errorPage="loiDatabase.jsp" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="WEB-INF/jspf/common.jspf" %>
<%request.setCharacterEncoding("UTF-8");String tuKhoa=request.getParameter("tuKhoa");if(tuKhoa==null)tuKhoa="";boolean daTim=request.getParameter("tuKhoa")!=null;String thongBao=daTim&&tuKhoa.trim().isEmpty()?"Vui lòng nhập tên món ăn cần tìm.":null;List<Monan> ds=thongBao!=null?Collections.emptyList():new MonanDAO().timTheoTen(daTim?tuKhoa:"");%>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Tìm kiếm món ăn · RestMan</title><link rel="stylesheet" href="<%=request.getContextPath()%>/style.css"></head><body><%@ include file="WEB-INF/jspf/header.jspf" %><main class="container"><a class="back" href="gdChinhKH.jsp">← Trang chủ khách hàng</a><section class="panel"><h2>Tìm kiếm thông tin món ăn</h2><form method="get" action="gdThongTinMonAn.jsp" class="form-row"><div class="field"><label for="tuKhoa">Tên món ăn</label><input id="tuKhoa" name="tuKhoa" value="<%=esc(tuKhoa)%>" placeholder="Ví dụ: vịt, phở, cơm..."></div><input type="hidden" name="module" value="timkiemmonan"><button class="btn" id="btnTimKiem" type="submit">Tìm kiếm</button></form><%if(thongBao!=null){%><div class="notice"><%=esc(thongBao)%></div><%}%></section><%if(thongBao==null){%><section class="panel"><h2><%=daTim?"Kết quả tìm kiếm":"Món ăn đề xuất"%> <span class="pill"><%=ds.size()%> kết quả</span></h2><div class="table-wrap"><table><thead><tr><th>STT</th><th>Tên món ăn</th><th>Loại</th><th class="num">Giá (VNĐ)</th><th>Thao tác</th></tr></thead><tbody><%int stt=0;for(Monan m:ds){%><tr><td><%=++stt%></td><td><b><%=esc(m.getTen())%></b></td><td><%=esc(m.getLoai())%></td><td class="num"><%=money(m.getGia())%></td><td><form method="get" action="gdThongTinChiTiet.jsp"><input type="hidden" name="id" value="<%=m.getId()%>"><input type="hidden" name="tuKhoa" value="<%=esc(tuKhoa)%>"><button class="btn btn-outline" type="submit">Xem chi tiết</button></form></td></tr><%}if(ds.isEmpty()){%><tr><td colspan="5" class="muted">Không tìm thấy món ăn có tên chứa từ khóa này.</td></tr><%}%></tbody></table></div></section><%}%></main></body></html>
