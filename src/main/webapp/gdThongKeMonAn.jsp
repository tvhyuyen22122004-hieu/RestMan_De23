<%@ page errorPage="loiDatabase.jsp" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="WEB-INF/jspf/common.jspf" %>
<%String start=request.getParameter("batDau"),end=request.getParameter("ketThuc");boolean daThongKe=start!=null&&end!=null;if(start==null)start="2026-11-01";if(end==null)end="2026-11-30";LocalDate batDau=null,ketThuc=null;String loi=null;try{batDau=LocalDate.parse(start);ketThuc=LocalDate.parse(end);if(batDau.isAfter(ketThuc))loi="Ngày bắt đầu phải trước hoặc bằng ngày kết thúc.";}catch(Exception e){loi="Vui lòng nhập ngày hợp lệ.";}List<ThongKeMonAn> ds=daThongKe&&loi==null?new ThongKeDAO().thongKe(batDau,ketThuc):Collections.emptyList();long tong=0;int luot=0,soluong=0;for(ThongKeMonAn t:ds){tong+=t.getDoanhThu();luot+=t.getSoLanGoi();soluong+=t.getSoLuong();}double max=ds.isEmpty()?1:Math.max(1,ds.get(0).getDoanhThu());%>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Báo cáo thống kê món ăn theo doanh thu · RestMan</title><link rel="stylesheet" href="<%=request.getContextPath()%>/style.css"></head><body><%@ include file="WEB-INF/jspf/header.jspf" %><main class="container"><nav class="crumb"><a href="gdChinhQL.jsp">Trang chủ quản lý</a><span>/</span><a href="gdBaoCao.jsp">Xem báo cáo</a><span>/</span> Thống kê món ăn theo doanh thu</nav><div class="page-heading"><div><div class="eyebrow dark">PHÂN TÍCH KINH DOANH</div><h1>Báo cáo thống kê món ăn theo doanh thu</h1><p class="muted">Dữ liệu lấy từ các hóa đơn đã thanh toán trong MySQL.</p></div></div><section class="panel"><h2>Khoảng thời gian thống kê</h2><form class="form-row" method="get" action="gdThongKeMonAn.jsp"><div class="field"><label for="batDau">Từ ngày</label><input type="date" id="batDau" name="batDau" required value="<%=esc(start)%>"></div><div class="field"><label for="ketThuc">Đến ngày</label><input type="date" id="ketThuc" name="ketThuc" required value="<%=esc(end)%>"></div><button class="btn" type="submit">Xem thống kê</button></form><%if(loi!=null){%><div class="notice"><%=esc(loi)%></div><%}%></section><%if(daThongKe&&loi==null){%><section class="metric-grid"><div class="metric"><div class="metric-label">Tổng doanh thu</div><div class="metric-value"><%=money(tong)%> <small>đ</small></div><div class="metric-note">Từ hóa đơn đã thanh toán</div></div><div class="metric"><div class="metric-label">Món có doanh thu</div><div class="metric-value"><%=ds.size()%></div><div class="metric-note">Món được bán trong kỳ</div></div><div class="metric"><div class="metric-label">Số lần gọi</div><div class="metric-value"><%=luot%></div><div class="metric-note">Tổng lượt gọi theo từng món</div></div><div class="metric"><div class="metric-label">Tổng số lượng bán</div><div class="metric-value"><%=soluong%></div><div class="metric-note">Tổng khẩu phần bán ra</div></div></section><%if(!ds.isEmpty()){%><div class="report-grid"><section class="panel"><div class="section-head"><h2>Top món ăn theo doanh thu</h2><span class="pill">Xếp hạng</span></div><div class="rank-list"><%int rank=0;for(ThongKeMonAn t:ds){if(++rank>6)break;int width=(int)Math.round(100*t.getDoanhThu()/max);%><div class="rank-item"><div class="rank-top"><span><b class="rank-num"><%=rank%></b> <%=esc(t.getMon().getTen())%></span><strong><%=money(t.getDoanhThu())%> đ</strong></div><div class="rank-track"><div class="rank-fill" style="width:<%=width%>%"></div></div></div><%}%></div></section><section class="panel"><h2>Tổng quan kỳ báo cáo</h2><p class="muted">Từ <strong><%=batDau.format(DateTimeFormatter.ofPattern("dd/MM/yyyy"))%></strong> đến <strong><%=ketThuc.format(DateTimeFormatter.ofPattern("dd/MM/yyyy"))%></strong></p><div class="insight"><span>Món có doanh thu cao nhất</span><strong><%=esc(ds.get(0).getMon().getTen())%></strong></div><div class="insight"><span>Doanh thu món dẫn đầu</span><strong><%=money(ds.get(0).getDoanhThu())%> đ</strong></div><div class="insight"><span>Giá trị doanh thu trung bình / món</span><strong><%=money(tong/ds.size())%> đ</strong></div><p class="muted small">Số lần gọi là số hóa đơn khác nhau có món đó; không phải tổng số lượng bán.</p></section></div><%}%><section class="panel"><div class="section-head"><h2>Danh sách thống kê món ăn</h2><span class="pill"><%=ds.size()%> món</span></div><div class="table-wrap"><table><thead><tr><th>STT</th><th>Tên món ăn</th><th class="num">Số lần gọi</th><th class="num">Tổng số lượng</th><th class="num">Doanh thu</th><th>Thao tác</th></tr></thead><tbody><%int stt=0;for(ThongKeMonAn t:ds){%><tr><td><%=++stt%></td><td><b><%=esc(t.getMon().getTen())%></b><div class="muted small"><%=esc(t.getMon().getLoai())%></div></td><td class="num"><%=t.getSoLanGoi()%></td><td class="num"><%=t.getSoLuong()%></td><td class="num revenue"><%=money(t.getDoanhThu())%> đ</td><td><a class="btn btn-outline" href="gdChiTietThongKe.jsp?monId=<%=t.getMon().getId()%>&amp;batDau=<%=esc(start)%>&amp;ketThuc=<%=esc(end)%>">Chi tiết →</a></td></tr><%}if(ds.isEmpty()){%><tr><td colspan="6" class="muted">Không có dữ liệu trong khoảng thời gian đã chọn.</td></tr><%}%></tbody></table></div></section><%}else if(loi==null){%><section class="panel empty-state"><h2>Sẵn sàng xem báo cáo</h2><p class="muted">Chọn khoảng thời gian và nhấn “Xem thống kê” để hiển thị số liệu từ MySQL.</p></section><%}%></main></body></html>