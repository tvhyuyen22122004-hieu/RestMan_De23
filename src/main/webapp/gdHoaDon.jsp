<%@ page errorPage="loiDatabase.jsp" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="WEB-INF/jspf/common.jspf" %>
<%ThongKeDAO dao=new ThongKeDAO();int hoaDonId=parseId(request.getParameter("hoaDonId"));HoaDon hd=dao.timHoaDon(hoaDonId);String monId=request.getParameter("monId"),start=request.getParameter("batDau"),end=request.getParameter("ketThuc");String back="gdThongKeMonAn.jsp";try{int mid=Integer.parseInt(monId);LocalDate s=LocalDate.parse(start),e=LocalDate.parse(end);if(!s.isAfter(e)&&dao.lanGoiMon(mid,s,e).stream().anyMatch(h->h.getId()==hoaDonId))back="gdChiTietThongKe.jsp?monId="+mid+"&amp;batDau="+esc(start)+"&amp;ketThuc="+esc(end);else hd=null;}catch(Exception ex){hd=null;}%>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Hóa đơn · RestMan</title><link rel="stylesheet" href="<%=request.getContextPath()%>/style.css"></head><body><%@ include file="WEB-INF/jspf/header.jspf" %><main class="container"><a class="back" href="<%=back%>">← Quay lại các lần gọi</a><section class="panel"><div class="section-head"><h2>Thông tin hóa đơn</h2><span class="pill">Đã thanh toán</span></div><%if(hd==null){%><div class="notice">Không tìm thấy hóa đơn tương ứng với lần gọi món.</div><%}else{%><dl class="details"><dt>Mã hóa đơn</dt><dd>HD<%=hd.getId()%></dd><dt>Ngày lập</dt><dd><%=dateTime(hd.getNgayLap())%></dd><dt>Khách hàng</dt><dd><%=esc(hd.getKhachHang())%></dd><dt>Bàn</dt><dd><%=esc(hd.getBan())%></dd></dl><h3>Danh sách món trong hóa đơn</h3><div class="table-wrap"><table><thead><tr><th>Món ăn</th><th class="num">Số lượng</th><th class="num">Đơn giá</th><th class="num">Thành tiền</th></tr></thead><tbody><%for(ChiTietHoaDon c:dao.chiTietHoaDon(hd.getId())){Monan m=dao.timMon(c.getMonAnId());%><tr><td><%=m==null?"(Không rõ)":esc(m.getTen())%></td><td class="num"><%=c.getSoLuong()%></td><td class="num"><%=money(c.getDonGia())%> đ</td><td class="num"><%=money(c.getThanhTien())%> đ</td></tr><%}%><tr><td colspan="3"><b>Tổng cộng</b></td><td class="num"><b><%=money(dao.tongTien(hd.getId()))%> đ</b></td></tr></tbody></table></div><%}%></section></main></body></html>
