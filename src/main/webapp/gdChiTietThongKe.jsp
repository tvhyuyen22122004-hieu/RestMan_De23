<%@ page errorPage="loiDatabase.jsp" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="WEB-INF/jspf/common.jspf" %>
<%ThongKeDAO dao=new ThongKeDAO();int monId=parseId(request.getParameter("monId"));Monan mon=dao.timMon(monId);String start=request.getParameter("batDau"),end=request.getParameter("ketThuc");LocalDate batDau=null,ketThuc=null;try{batDau=LocalDate.parse(start);ketThuc=LocalDate.parse(end);if(batDau.isAfter(ketThuc))throw new IllegalArgumentException();}catch(Exception e){batDau=null;}List<HoaDon> ds=(mon!=null&&batDau!=null)?dao.lanGoiMon(monId,batDau,ketThuc):Collections.emptyList();int tongSL=0;long doanhThu=0;for(HoaDon h:ds){for(ChiTietHoaDon c:dao.chiTietHoaDon(h.getId()))if(c.getMonAnId()==monId){tongSL+=c.getSoLuong();doanhThu+=c.getThanhTien();}}%>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Các lần gọi món · RestMan</title><link rel="stylesheet" href="<%=request.getContextPath()%>/style.css"></head><body><%@ include file="WEB-INF/jspf/header.jspf" %><main class="container"><a class="back" href="gdThongKeMonAn.jsp<%=batDau==null?"":"?batDau="+esc(start)+"&amp;ketThuc="+esc(end)%>">← Quay lại báo cáo</a><section class="panel"><h2>Các lần món ăn được gọi</h2><%if(mon==null||batDau==null){%><div class="notice">Thông tin món ăn hoặc khoảng thời gian không hợp lệ.</div><%}else{%><p><b>Món ăn:</b> <%=esc(mon.getTen())%> · <b>Thời gian:</b> <%=batDau.format(DateTimeFormatter.ofPattern("dd/MM/yyyy"))%> – <%=ketThuc.format(DateTimeFormatter.ofPattern("dd/MM/yyyy"))%></p><div class="metric-grid metric-grid-3"><div class="metric"><div class="metric-label">Số lần gọi</div><div class="metric-value"><%=ds.size()%></div></div><div class="metric"><div class="metric-label">Tổng số lượng</div><div class="metric-value"><%=tongSL%></div></div><div class="metric"><div class="metric-label">Doanh thu món ăn</div><div class="metric-value"><%=money(doanhThu)%> <small>đ</small></div></div></div><div class="table-wrap"><table><thead><tr><th>STT</th><th>Mã hóa đơn</th><th>Ngày gọi</th><th>Bàn</th><th class="num">Số lượng món</th><th>Thao tác</th></tr></thead><tbody><%int stt=0;for(HoaDon h:ds){int soLuong=0;for(ChiTietHoaDon c:dao.chiTietHoaDon(h.getId()))if(c.getMonAnId()==monId)soLuong+=c.getSoLuong();%><tr><td><%=++stt%></td><td>HD<%=h.getId()%></td><td><%=dateTime(h.getNgayLap())%></td><td><%=esc(h.getBan())%></td><td class="num"><%=soLuong%></td><td><form method="get" action="gdHoaDon.jsp"><input type="hidden" name="hoaDonId" value="<%=h.getId()%>"><input type="hidden" name="monId" value="<%=monId%>"><input type="hidden" name="batDau" value="<%=esc(start)%>"><input type="hidden" name="ketThuc" value="<%=esc(end)%>"><button type="submit" class="btn btn-outline">Xem hóa đơn</button></form></td></tr><%}%></tbody></table></div><%}%></section></main></body></html>
